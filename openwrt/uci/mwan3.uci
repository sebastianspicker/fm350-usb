# Idempotent uci batch snippet: mwan3 failover between "wan" (primary) and
# "wwan" (the FM350 cellular backup), per docs/setup-guide.md step 7. Applied
# by install.sh with `uci -q batch` only when --no-mwan3 is not given.
#
# "globals" and "wan" are NOT installer-owned: opkg's mwan3 package ships a
# default /etc/config/mwan3 with its own "globals" and "wan" sections (plus
# wan6/wanb/wanb6 interfaces, weighted members and a "balanced" policy) that
# a user may already have tuned. We only set the specific options this
# failover setup needs on those two sections. mwan3.wan.track_ip is merged in
# by install.sh directly with `uci` (not here): it only add_lists a track IP
# that isn't already present, and records which ones it actually added in
# mwan3.wan.fm350_added_track_ip, so uninstall.sh can remove exactly those and
# nothing else (a track IP that coincidentally already existed, e.g. because
# it's also a stock mwan3 default, is left alone by uninstall.sh).
#
# "wwan", "wan_m1", "wwan_m2", "failover" and "default" are exclusively ours
# (install.sh created them): they are deleted and recreated every run so
# re-running the installer never duplicates track_ip/use_member list entries.
#
# The stock "https" / "default_rule_v4" rules that ship with mwan3 (policy
# "balanced", matched before an appended "default" rule) would otherwise
# shadow our failover rule for all IPv4 traffic. install.sh additionally:
#   - reorders "default" to right after "globals" so it is the first rule
#     evaluated for any section named "rule" (mwan3 is first-match);
#   - points the stock "https"/"default_rule_v4" rules (if present) at our
#     "failover" policy too, saving their original use_policy in a
#     "fm350_orig_policy" option so uninstall.sh can restore it.
# That rule-neutralising step needs an existence check per rule, so it is
# done by install.sh directly with `uci` rather than in this static batch
# file. IPv6 ("default_rule_v6") is handled there too: pointed at the stock
# wan_only policy when wan6 is enabled, otherwise removed, with the original
# saved for uninstall.sh; see README.md.
#
# Metered-link defaults: wan is probed every 5 s and marked down after 5
# misses (25 s) / up after 10 successes (50 s), so a short blip doesn't move
# traffic onto the metered SIM; wwan is probed every 30 s with at most two
# track IPs (reliability 1) to keep tracking traffic small (see README.md).
#
# Every section created here carries option fm350_owned='1' so install.sh can
# tell its own sections from a user's own sections with the same names (those
# are saved before being replaced and restored by uninstall.sh).
set mwan3.globals=globals

set mwan3.wan=interface
set mwan3.wan.enabled='1'
set mwan3.wan.family='ipv4'
set mwan3.wan.interval='5'
set mwan3.wan.down='5'
set mwan3.wan.up='10'

delete mwan3.wwan
set mwan3.wwan=interface
set mwan3.wwan.fm350_owned='1'
set mwan3.wwan.enabled='1'
set mwan3.wwan.family='ipv4'
add_list mwan3.wwan.track_ip='1.1.1.1'
add_list mwan3.wwan.track_ip='9.9.9.9'
set mwan3.wwan.reliability='1'
set mwan3.wwan.interval='30'
set mwan3.wwan.down='3'
set mwan3.wwan.up='3'

delete mwan3.wan_m1
set mwan3.wan_m1=member
set mwan3.wan_m1.fm350_owned='1'
set mwan3.wan_m1.interface='wan'
set mwan3.wan_m1.metric='1'

delete mwan3.wwan_m2
set mwan3.wwan_m2=member
set mwan3.wwan_m2.fm350_owned='1'
set mwan3.wwan_m2.interface='wwan'
set mwan3.wwan_m2.metric='2'

delete mwan3.failover
set mwan3.failover=policy
set mwan3.failover.fm350_owned='1'
add_list mwan3.failover.use_member='wan_m1'
add_list mwan3.failover.use_member='wwan_m2'
set mwan3.failover.last_resort='unreachable'

delete mwan3.default
set mwan3.default=rule
set mwan3.default.fm350_owned='1'
set mwan3.default.dest_ip='0.0.0.0/0'
set mwan3.default.family='ipv4'
set mwan3.default.use_policy='failover'
reorder mwan3.default=1

commit mwan3
