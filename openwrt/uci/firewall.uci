# Idempotent uci batch snippet: put "wwan" in the wan firewall zone's network
# list. Applied by install.sh with `uci -q batch`. No IPv6 RA rule: the PDP is
# IPv4-only. The delete below clears the rule older installers added.
#
# Placeholder substituted by install.sh before piping to `uci -q batch`:
#   @WAN_ZONE@ - uci reference of the existing zone with option name='wan'
#                (e.g. @zone[1] or a named section), resolved by install.sh
#                since firewall zones are anonymous by default and cannot be
#                addressed by name directly.
#
# del_list before add_list keeps this idempotent: uci silently no-ops a
# del_list for a value that isn't present, so running this twice never
# produces a duplicate "wwan" entry.
del_list @WAN_ZONE@.network='wwan'
add_list @WAN_ZONE@.network='wwan'

delete firewall.wwan_allow_ra

commit firewall
