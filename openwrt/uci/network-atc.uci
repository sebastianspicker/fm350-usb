# Idempotent uci batch snippet: wwan interface using the mrhaav atc-fib-fm350_gl
# protocol handler (proto "atc"). Applied by install.sh with `uci -q batch`.
#
# Option names verified against mrhaav/openwrt-packages @
# atc-fib-fm350_gl/files/lib/netifd/proto/atc.sh (proto_atc_init_config) and
# luci/protocols/luci-proto-atc/htdocs/luci-static/resources/protocol/atc.js
# (2025-08-24 script revision), 2026-09-25.
#
# Placeholders substituted by install.sh before piping to `uci -q batch`:
#   @DEVICE@ - AT command tty, e.g. /dev/ttyUSB4
#   @APN@    - carrier APN
#
# The section is deleted first so re-running the installer never leaves stale
# options (e.g. from a previous --proto xmm run) behind. install.sh itself
# re-applies user-added options (pincode, atc_debug, custom_at, pdp, ...)
# after this template on a re-run with the same proto, and saves a
# pre-existing section lacking the fm350_owned marker for uninstall.sh.
delete network.wwan
set network.wwan=interface
set network.wwan.fm350_owned='1'
set network.wwan.proto='atc'
set network.wwan.device='@DEVICE@'
set network.wwan.apn='@APN@'
set network.wwan.pdp='IP'
set network.wwan.auth='0'
set network.wwan.delay='15'
set network.wwan.defaultroute='1'
set network.wwan.peerdns='1'
set network.wwan.metric='20'

set network.wan.metric='10'

commit network
