#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # START/STOP/USE_PROCD are read by /etc/rc.common,
# which sources this file; shellcheck's single-file analysis can't see that.
#
# fm350-watchdog - procd wrapper around /usr/sbin/fm350-watchdog. See that
# script's header comment for the watchdog logic and its uci config
# (fm350_watchdog.main, applied from uci/fm350-watchdog.uci by install.sh).
START=95
STOP=10
USE_PROCD=1

start_service() {
	# fm350_watchdog.main.enabled=0: don't even create a procd instance, so
	# there is nothing for procd to (re)spawn while disabled.
	[ "$(uci -q get fm350_watchdog.main.enabled)" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/fm350-watchdog
	# threshold 3600 s, retry delay 5 s, retries 0 = respawn indefinitely
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger fm350_watchdog
}
