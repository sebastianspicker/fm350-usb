#!/bin/sh
# shellcheck disable=SC2034,SC2154 # FM350_WATCHDOG_TEST is read, and interface/
# enabled are set, by the sourced watchdog; shellcheck can't see that.
# fm350-usb: installed by openwrt/install.sh
# Hotplug helper: after the FM350-GL (0e8d:7126 / 0e8d:7127) re-enumerates on
# USB (typically a modem crash), restart wwan at once instead of waiting for
# the watchdog's pending_threshold: wait for the AT port, re-resolve
# network.wwan.device (ttyUSB renumbering), then one ifdown/ifup.
#
# Reuses the watchdog's helpers (sourced, not run): its pause file, the
# disabled/auto and PIN/PUK block checks, sync_device and restart_interface,
# which skips the ifdown/ifup when the device change already made netifd
# reload the interface. install.sh installs this file only together with the
# watchdog. The paths are fixed on purpose: this runs as root, so it takes
# no path to source or write from the environment (tests rewrite a copy).

[ "$ACTION" = add ] || exit 0

case "$PRODUCT" in
	e8d/7126/* | e8d/7127/*) ;;
	*) exit 0 ;;
esac

watchdog=/usr/sbin/fm350-watchdog
lock=/tmp/fm350-reenum.lock
[ -r "$watchdog" ] || exit 0

# One run per re-enumeration: the device and each of its interfaces raise an
# add event. shortcut: a SIGKILLed run leaves the lock until reboot (tmpfs).
mkdir "$lock" 2>/dev/null || exit 0

reenum() {
	trap 'rmdir "$lock"' EXIT
	FM350_WATCHDOG_TEST=1
	# shellcheck source=/dev/null # files/usr/sbin/fm350-watchdog
	. "$watchdog"
	load_config

	sleep 5 # let the other interfaces and netifd settle
	tries=0
	until fm350_find_at_device >/dev/null; do
		tries=$((tries + 1))
		if [ "$tries" -gt 30 ]; then
			log "modem re-enumerated but no AT port appeared; leaving $interface to the watchdog"
			exit 0
		fi
		sleep 2
	done

	[ "$enabled" = "0" ] && exit 0
	paused && exit 0
	should_manage || exit 0
	blocked=0
	sim_blocked || blocked=$?
	if [ "$blocked" -eq 0 ]; then
		log "modem re-enumerated but $interface is blocked by a SIM/PIN error; not restarting it"
		exit 0
	fi

	if [ "$(uptime_s)" -lt "$boot_grace" ]; then
		# Boot coldplug, not a crash: netifd brings $interface up itself, and
		# an ifdown/ifup now would cut its registration short (watchdog rule).
		sync_device
		exit 0
	fi

	log "modem re-enumerated (PRODUCT $PRODUCT), restarting $interface"
	restart_interface
}

reenum >/dev/null 2>&1 </dev/null &
